# ─────────────────────────────────────────────────────────────
# HexaCore Postulaciones — variables de entorno de la web
# Copia este archivo a .env (en local) y pon los mismos valores en
# Vercel → tu proyecto → Settings → Environment Variables.
# NUNCA subas el .env a GitHub.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Supabase) ─────────────────────────────────
# En Vercel las crea solas la integración: Vercel → Storage → Supabase → Connect.
# En local, cópialas de Supabase → Connect → ORMs → Prisma.
POSTGRES_PRISMA_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
POSTGRES_URL_NON_POOLING="postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ── Inicio de sesión ─────────────────────────────────────────
# En local: http://localhost:3000 · En Vercel: la URL final de tu web (sin barra al final)
NEXTAUTH_URL="http://localhost:3000"
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Aplicación de Discord (Developer Portal → OAuth2) ────────
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# ID de tu servidor de Discord
DISCORD_GUILD_ID=""
# Token del bot (recomendado): la web lo usa para releer roles cada 10 min
DISCORD_BOT_TOKEN=""

# ── Roles de tu servidor (IDs de Discord) ────────────────────
# Revisan y deciden postulaciones
REVIEWER_ROLE_ID=""
# Además crean y editan formularios
ADMIN_ROLE_ID=""
# Opcional: si lo rellenas, solo quien tenga este rol puede postular
MEMBER_ROLE_ID=""

# Invitación a tu Discord (se enseña a quien no está dentro)
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/tu-invitacion"

# ── Conexión con el bot ──────────────────────────────────────
# El MISMO valor va en el .env del bot (mínimo 16 caracteres).
# Genera uno con: openssl rand -hex 32
BOT_API_SECRET=""
# Opcional: si tu bot tiene puerto HTTP público, los MD llegan al instante. Ej: https://tu-bot.com/kick
BOT_WEBHOOK_URL=""
