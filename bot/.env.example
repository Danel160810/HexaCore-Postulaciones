# ─── HexaCore Postulaciones · Bot ───────────────────────────
# Copia este archivo a .env y rellénalo. NUNCA subas el .env a GitHub.

# Token del bot (Developer Portal → tu aplicación → Bot → Reset Token)
DISCORD_BOT_TOKEN=
# ID de tu servidor de Discord (clic derecho en el servidor → Copiar ID; activa el modo desarrollador)
DISCORD_GUILD_ID=

# URL pública de tu web (sin barra final)
WEB_URL=https://tu-web.vercel.app
# El MISMO secreto que BOT_API_SECRET en la web (mínimo 16 caracteres)
BOT_API_SECRET=

# Canal donde el bot registra nuevas postulaciones y decisiones (opcional)
LOG_CHANNEL_ID=
# Rol que se menciona cuando entra una postulación nueva (opcional)
REVIEWER_ROLE_ID=

# Tu marca en los mensajes del bot
BRAND_NAME=Mi Comunidad
BRAND_COLOR=#4FDC86

# Cada cuánto pregunta a la web por eventos nuevos (ms). 10000 = 10 s
POLL_INTERVAL_MS=10000

# Opcional: solo si tu hosting expone un puerto HTTP público para el bot.
# Entonces pon en la web BOT_WEBHOOK_URL=https://tu-bot/kick y los MDs llegan al instante.
BOT_HTTP_PORT=
